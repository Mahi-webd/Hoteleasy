# From Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: the hotel whose website opens at / for visitors (its booking-page address, e.g. lakeside-lodge).
# Leave empty to open the sign-in page. In `npm run dev` it defaults to the sample hotel (demo).
VITE_HOME_HOTEL=

# Optional, for many hotels on one live system (see src/lib/siteHost.ts):
# hotel subdomains: lakeside-lodge.hoteleasy.co.ke opens that hotel's website (needs a wildcard domain in Vercel)
VITE_SITE_ROOT_DOMAIN=
# addresses that always open the staff app, comma separated (e.g. app.hoteleasy.co.ke)
VITE_APP_HOSTS=
